-- 1. TABLA USUARIOS
CREATE TABLE IF NOT EXISTS public.usuarios (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    nombre TEXT NOT NULL,
    esta_activo BOOLEAN DEFAULT true,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 2. TABLA NODOS
CREATE TABLE IF NOT EXISTS public.nodos (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    nombre TEXT NOT NULL,
    clave_del_dispositivo TEXT UNIQUE NOT NULL,
    latitud DOUBLE PRECISION NOT NULL,
    longitud DOUBLE PRECISION NOT NULL,
    activo BOOLEAN DEFAULT true,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 3. TABLA LECTURAS
CREATE TABLE IF NOT EXISTS public.lecturas (
    identificacion SERIAL PRIMARY KEY,
    nodo_id UUID NOT NULL REFERENCES public.nodos(id) ON DELETE CASCADE,
    lux DOUBLE PRECISION NOT NULL DEFAULT 0,
    ruido DOUBLE PRECISION NOT NULL DEFAULT 0,
    fecha TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 4. TABLA REPORTES
CREATE TABLE IF NOT EXISTS public.reportes (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    usuario_id UUID NOT NULL REFERENCES public.usuarios(id) ON DELETE CASCADE,
