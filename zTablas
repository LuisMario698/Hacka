CREATE OR REPLACE FUNCTION public.registrar_usuario(p_email TEXT, p_password TEXT, p_nombre TEXT, p_rol_id INTEGER DEFAULT 1)
RETURNS UUID AS $$
DECLARE v_usuario_id UUID;
BEGIN
    IF p_email !~ '^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+[.][A-Za-z]+$' THEN RAISE EXCEPTION 'Email inválido'; END IF;
    IF length(p_password) < 8 THEN RAISE EXCEPTION 'La contraseña debe tener al menos 8 caracteres'; END IF;
    INSERT INTO public.usuarios (email, password_hash, nombre, rol_id, esta_activo)
    VALUES (lower(p_email), crypt(p_password, gen_salt('bf')), p_nombre, p_rol_id, true)
    RETURNING id INTO v_usuario_id;
    RETURN v_usuario_id;
EXCEPTION WHEN unique_violation THEN RAISE EXCEPTION 'El email ya está registrado';
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

CREATE OR REPLACE FUNCTION public.login_usuario(p_email TEXT, p_password TEXT)
RETURNS TABLE(id UUID, email TEXT, nombre TEXT, rol_id INTEGER, rol_nombre VARCHAR(50), esta_activo BOOLEAN, permisos JSONB) AS $$
BEGIN
    UPDATE public.usuarios u SET ultimo_login = NOW()
    WHERE lower(u.email) = lower(p_email) AND u.password_hash = crypt(p_password, u.password_hash) AND u.esta_activo = true AND u.deleted_at IS NULL;
    RETURN QUERY
    SELECT u.id, u.email, u.nombre, u.rol_id, r.nombre as rol_nombre, u.esta_activo, r.permisos
    FROM public.usuarios u INNER JOIN public.roles r ON u.rol_id = r.id
    WHERE lower(u.email) = lower(p_email) AND u.password_hash = crypt(p_password, u.password_hash) AND u.esta_activo = true AND u.deleted_at IS NULL;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- PASO 13: TRIGGERS
CREATE OR REPLACE FUNCTION public.actualizar_updated_at() RETURNS TRIGGER AS $$
BEGIN NEW.updated_at = NOW(); RETURN NEW; END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_usuarios_updated_at BEFORE UPDATE ON public.usuarios FOR EACH ROW EXECUTE FUNCTION actualizar_updated_at();
CREATE TRIGGER trigger_nodos_updated_at BEFORE UPDATE ON public.nodos FOR EACH ROW EXECUTE FUNCTION actualizar_updated_at();
CREATE TRIGGER trigger_reportes_updated_at BEFORE UPDATE ON public.reportes FOR EACH ROW EXECUTE FUNCTION actualizar_updated_at();
CREATE TRIGGER trigger_tramos_updated_at BEFORE UPDATE ON public.tramos_calle FOR EACH ROW EXECUTE FUNCTION actualizar_updated_at();
CREATE TRIGGER trigger_roles_updated_at BEFORE UPDATE ON public.roles FOR EACH ROW EXECUTE FUNCTION actualizar_updated_at();

CREATE OR REPLACE FUNCTION public.actualizar_estado_nodo() RETURNS TRIGGER AS $$
BEGIN UPDATE public.nodos SET ultima_lectura = NEW.fecha, estado_conexion = 'online' WHERE id = NEW.nodo_id; RETURN NEW; END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_lectura_actualiza_nodo AFTER INSERT ON public.lecturas FOR EACH ROW EXECUTE FUNCTION actualizar_estado_nodo();

