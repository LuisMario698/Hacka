Estructura de las tablas de supabase, proyecto Hacka 2025

create table public.lecturas (
  identificacion serial not null,
  nodo_id uuid null,
  fecha timestamp with time zone null default CURRENT_TIMESTAMP,
  lux double precision null,
  ruido_db double precision null,
  constraint lecturas_pkey primary key (identificacion),
  constraint lecturas_nodo_id_fkey foreign KEY (nodo_id) references nodos (id) on delete CASCADE
) TABLESPACE pg_default;

create table public.lecturas_sensor (
  id bigint generated by default as identity not null,
  fecha timestamp with time zone not null default now(),
  luminosidad double precision not null default '0'::double precision,
  ruido double precision not null default '0'::double precision,
  constraint lecturas_sensor_pkey primary key (id),
  constraint lecturas_sensor_id_key unique (id)
) TABLESPACE pg_default;

create table public.nodos (
  id uuid not null default extensions.uuid_generate_v4 (),
  nombre text not null,
  latitud double precision not null,
  largo double precision not null,
  clave_del_dispositivo text not null,
  activo boolean null default true,
  creado_en timestamp with time zone null default CURRENT_TIMESTAMP,
  constraint nodos_pkey primary key (id)
) TABLESPACE pg_default;

create table public.reportes (
  id uuid not null default gen_random_uuid (),
  usuario_id uuid not null,
  titulo text not null,
  descripcion text null,
  lat double precision not null,
  lon double precision not null,
  url_evidencia text null,
  estado character varying not null,
  created_at timestamp with time zone null default now(),
  constraint reportes_pkey primary key (id),
  constraint reportes_usuario_id_fkey foreign KEY (usuario_id) references usuarios (id)
) TABLESPACE pg_default;

create table public.rutas_historial (
  id uuid not null default gen_random_uuid (),
  usuario_id uuid not null,
  origen_lat double precision not null,
  origen_lon double precision not null,
  destino_lat double precision not null,
  destino_lon double precision not null,
  geojson_ruta jsonb not null,
  distancia_km double precision null,
  duracion_estimada_min integer null,
  seguridad_promedio smallint null,
  created_at timestamp with time zone null default now(),
  constraint rutas_historial_pkey primary key (id),
  constraint rutas_historial_usuario_id_fkey foreign KEY (usuario_id) references usuarios (id)
) TABLESPACE pg_default;

create table public.tramos_calle (
  id serial not null,
  nombre_calle text null,
  lat_inicio double precision not null,
  lon_inicio double precision not null,
  lat_fin double precision not null,
  lon_fin double precision not null,
  nivel_seguridad smallint not null default 0,
  ultima_actualizacion timestamp with time zone null,
  constraint tramos_calle_pkey primary key (id),
  constraint tramos_calle_nivel_seguridad_check check (
    (
      (nivel_seguridad >= 0)
      and (nivel_seguridad <= 10)
    )
  )
) TABLESPACE pg_default;

create table public.usuarios (
  id uuid not null default gen_random_uuid (),
  email text not null,
  password_hash text not null,
  nombre text null,
  rol character varying not null,
  esta_activo boolean not null default true,
  created_at timestamp with time zone null default now(),
  constraint usuarios_pkey primary key (id),
  constraint usuarios_email_key unique (email),
  constraint usuarios_email_check check (
    (
      email ~* '^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+[.][A-Za-z]+$'::text
    )
  )
) TABLESPACE pg_default;